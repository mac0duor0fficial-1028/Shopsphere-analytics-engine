# RULES: no quotes, no spaces in values. Key paths MUST be absolute (dbt/Dagster run from subfolders).
# URL-encode special characters in passwords used inside PG_DSN.

# ---------- Source Postgres (local docker) ----------
POSTGRES_USER=shop_admin
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=shopsphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AIRBYTE_CDC_PASSWORD=change_me_cdc_password
# Used by the generator (outside docker), Dagster monitoring and reconciliation
PG_DSN=postgresql://shop_admin:change_me_local_only@localhost:5432/shopsphere

# ---------- Traffic generator ----------
SESSIONS_PER_SEC=5
SEED_CUSTOMERS=500
SEED_PRODUCTS=120

# ---------- Snowflake (admin credentials: bootstrap only, never used by pipelines) ----------
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PASSWORD=
# Preferred if your admin user enforces MFA: key-pair auth for the bootstrap script
SNOWFLAKE_ADMIN_PRIVATE_KEY_PATH=
SNOWFLAKE_ADMIN_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_MONTHLY_CREDIT_QUOTA=100
# One-line public keys (no PEM header/footer) for the service users
AIRBYTE_RSA_PUBLIC_KEY=
DBT_RSA_PUBLIC_KEY=
BI_RSA_PUBLIC_KEY=

# ---------- dbt (service user SVC_DBT, key-pair auth) ----------
DBT_TARGET=dev
DBT_SNOWFLAKE_USER=SVC_DBT
SNOWFLAKE_PRIVATE_KEY_PATH=/ABSOLUTE/PATH/TO/repo/secrets/svc_dbt.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
DBT_DEV_SCHEMA_SUFFIX=yourname

# ---------- Airbyte public API (abctl: `abctl local credentials`) ----------
AIRBYTE_API_URL=http://localhost:8000/api/public/v1
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_ID=
AIRBYTE_CONNECTION_ID=
# Postgres as seen FROM the Airbyte containers (host.docker.internal on Docker Desktop)
AIRBYTE_SOURCE_PG_HOST=host.docker.internal
AIRBYTE_SNOWFLAKE_PRIVATE_KEY_PATH=/ABSOLUTE/PATH/TO/repo/secrets/svc_airbyte.p8
AIRBYTE_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# manual (Dagster triggers syncs) or a Quartz cron expression, e.g. "0 */10 * * * ?"
AIRBYTE_SCHEDULE=manual

# ---------- Orchestration / monitoring ----------
SLACK_WEBHOOK_URL=
CDC_MAX_RETAINED_WAL_MB=2048
RECON_TOLERANCE_PCT=0.5

# ---------- BI (service user SVC_BI) ----------
BI_SNOWFLAKE_USER=SVC_BI
BI_PRIVATE_KEY_PATH=/ABSOLUTE/PATH/TO/repo/secrets/svc_bi.p8
BI_PRIVATE_KEY_PASSPHRASE=
